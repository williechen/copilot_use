+#[tokio::test]
+async fn missing_schema_version_returns_422() {
+    // Schema v1 要求明確版本欄位，禁止靜默預設。
+    let body = format!(
+        r#"{{"event_id":"{ID}","source_app":"web_chat",
+            "event_type":"message.persisted"}}"#
+    );
+    assert_eq!(
+        response_status(post(&body)).await,
+        StatusCode::UNPROCESSABLE_ENTITY
+    );
+}
