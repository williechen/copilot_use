+/// All event types for one exact source; same PG statement gives one snapshot.
+pub async fn summary_for_source(
+    pool: &sqlx::PgPool,
+    source: &str,
+) -> Result<Vec<EventSummary>, sqlx::Error> {
+    sqlx::query_as::<_, EventSummary>(
+        "SELECT source_app, event_type, COUNT(*)::bigint AS total
+         FROM product_events
+         WHERE source_app = $1
+         GROUP BY source_app, event_type
+         ORDER BY event_type",
+    )
+    .bind(source)
+    .fetch_all(pool)
+    .await
+}
