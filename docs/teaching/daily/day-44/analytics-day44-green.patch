+pub fn render_dashboard(source_label: &'static str, total: i64) -> String {
+    let source = if source_label == "Pet" {
+        "desktop_pet"
+    } else {
+        "web_chat"
+    };
+    render_dashboard_filtered(source_label, total, source, "")
+}
