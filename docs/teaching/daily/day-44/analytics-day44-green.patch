+pub fn render_change_password_with_logout(
+    restricted: bool, csrf: String, logout_csrf: String,
+) -> String {
+    format!(
+        "<!doctype html>{}",
+        view! {
+            <ChangePasswordView restricted csrf logout_csrf/>
+        }
+        .to_html()
+    )
+}
