+                    <button type="submit">"儲存並重新登入"</button>
+                </form>
+                <p>"成功後所有裝置都須重新登入。Email不驗證；寄信重設尚未接通。"</p>
+                <form method="post" action="/logout">
+                    <input type="hidden" name="csrf" value=logout_csrf/>
+                    <button type="submit">"登出"</button>
+                </form>
+            </main></body>
+        </html>
+    }
+}
