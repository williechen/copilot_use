+        assert_eq!(export_csv_url("web_chat", ""), "/api/v1/events/web_chat/export.csv");
+        assert_eq!(export_csv_url("desktop_pet", "pet.中文 &"),
+            "/api/v1/events/desktop_pet/export.csv?event_type=pet.%E4%B8%AD%E6%96%87%20%26");
     }
