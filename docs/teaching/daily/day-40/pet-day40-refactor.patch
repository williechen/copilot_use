     pub fn remove(&self, id: &str) {
+        // Lifecycle cleanup belongs to Runtime, regardless of cage IPC or native Destroyed.
+        if let Ok(name) = label(id) {
+            crate::roam::stop_for_pet(&name);
+        }
         if let Ok(mut pets) = self.machines.lock() {
             pets.remove(id);
         }
