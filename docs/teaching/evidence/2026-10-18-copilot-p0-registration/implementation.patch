+-- Existing accounts retain NULL email until the account settings flow supplies it.
+-- Duplicate case variants abort this migration; never silently merge identities.
+ALTER TABLE chat_users ADD COLUMN email TEXT;
+CREATE UNIQUE INDEX chat_users_username_nocase ON chat_users(username COLLATE NOCASE);
+CREATE UNIQUE INDEX chat_users_email_nocase ON chat_users(email COLLATE NOCASE) WHERE email IS NOT NULL;
