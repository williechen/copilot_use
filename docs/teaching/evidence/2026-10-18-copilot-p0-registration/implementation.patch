+
+// A practical unquoted mailbox form; normalization makes uniqueness deterministic.
+fn registration_email(value: &str) -> Result<String, StatusCode> {
+    let email = value.trim().to_ascii_lowercase();
+    let (local, domain) = email.split_once('@').ok_or(StatusCode::BAD_REQUEST)?;
+    let local_ok = !local.is_empty()
+        && local.len() <= 64
+        && !local.starts_with('.')
+        && !local.ends_with('.')
+        && !local.contains("..")
+        && local
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b".!#$%&'*+-/=?^_`{|}~".contains(&b));
+    let domain_ok = domain.contains('.')
+        && domain.split('.').all(|label| {
+            !label.is_empty()
+                && label.len() <= 63
+                && !label.starts_with('-')
+                && !label.ends_with('-')
+                && label
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+        });
+    if email.len() > 254 || !local_ok || !domain_ok {
+        return Err(StatusCode::BAD_REQUEST);
+    }
+    Ok(email)
+}
