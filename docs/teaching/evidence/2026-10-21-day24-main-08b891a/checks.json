{
  "fmt": {
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 0
  },
  "ssr": {
    "command": [
      "cargo",
      "check",
      "--locked",
      "-p",
      "server",
      "--features",
      "ssr"
    ],
    "exit_code": 0
  },
  "chat-wasm": {
    "command": [
      "cargo",
      "check",
      "--locked",
      "-p",
      "ui",
      "--features",
      "hydrate",
      "--target",
      "wasm32-unknown-unknown"
    ],
    "exit_code": 0
  },
  "pet-wasm": {
    "command": [
      "cargo",
      "check",
      "--locked",
      "-p",
      "desktop-pet-frontend",
      "--target",
      "wasm32-unknown-unknown"
    ],
    "exit_code": 0
  },
  "build": {
    "command": [
      "cargo",
      "build",
      "--locked",
      "-p",
      "server",
      "--features",
      "ssr",
      "-p",
      "stats-server",
      "--bins",
      "-p",
      "desktop-pet"
    ],
    "exit_code": 0
  },
  "clippy": {
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--workspace",
      "--exclude",
      "desktop-pet-frontend",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 101
  }
}
