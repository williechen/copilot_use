+#[derive(Default, Deserialize)]
+struct RoomSearch {
+    #[serde(default)]
+    q: String,
+}
+fn room_name_pattern(query: &str) -> Result<String, StatusCode> {
+    if query.len() > 200 || query.contains('\0') {
+        return Err(StatusCode::BAD_REQUEST);
+    }
+    let literal = query
+        .trim()
+        .replace('\\', "\\\\")
+        .replace('%', "\\%")
+        .replace('_', "\\_");
+    Ok(format!("%{literal}%"))
+}
+async fn public_rooms(
+    State(s): State<StateData>,
+    Query(search): Query<RoomSearch>,
+) -> Result<Json<Vec<PublicRoomItem>>, StatusCode> {
