@@ -470,3 +470,130 @@ async fn anonymous_directory_exposes_only_public_names_without_granting_entry()
         403
     );
 }
+
+#[tokio::test]
+async fn sql_name_search_precedes_limit_and_keeps_public_and_member_boundaries() {
+    let f = fixture().await;
+    let owner = json!({"username":"search_owner","password":"synthetic-fixture-password"});
+    let guest = json!({"username":"search_guest","password":"synthetic-fixture-password"});
+    assert_eq!(
+        post(&f, "/register", registration(&owner), None)
+            .await
+            .status(),
+        201
+    );
+    assert_eq!(
+        post(&f, "/register", registration(&guest), None)
+            .await
+            .status(),
+        201
+    );
+    let owner_login = post(&f, "/login", owner, None).await;
+    let owner_cookie = owner_login.headers()["set-cookie"]
+        .to_str()
+        .unwrap()
+        .split(';')
+        .next()
+        .unwrap()
+        .to_owned();
+    let guest_login = post(&f, "/login", guest, None).await;
+    let guest_cookie = guest_login.headers()["set-cookie"]
+        .to_str()
+        .unwrap()
+        .split(';')
+        .next()
+        .unwrap()
+        .to_owned();
+    for (id, name, private) in [
+        ("rust-one", "Rust 技術交流", false),
+        ("rust-two", "Rust 技術交流", false),
+        ("rust-more", "Rust 技術交流延伸", false),
+        ("rust-secret", "Rust 私密房", true),
+        ("percent", "100% 活動", false),
+        ("underscore", "under_score", false),
+        ("slash", r"back\slash", false),
+    ] {
+        assert_eq!(
+            post(
+                &f,
+                "/room",
+                json!({"id":id,"name":name,"is_private":private}),
+                Some(&owner_cookie)
+            )
+            .await
+            .status(),
+            201
+        );
+    }
+    // Search must run before LIMIT, otherwise these visible matching rooms disappear.
+    for i in 0..110 {
+        sqlx::query("INSERT INTO chat_rooms(id,name,is_private) VALUES(?1,?2,false)")
+            .bind(format!("filler-{i}"))
+            .bind(format!("AAA filler {i}"))
+            .execute(&f.pool)
+            .await
+            .unwrap();
+    }
+    let client = reqwest::Client::new();
+    for path in ["/public/rooms", "/rooms"] {
+        for query in [" Rust 技術交流 ", "rUsT"] {
+            let mut request = client
+                .get(format!("{}{path}", f.url))
+                .query(&[("q", query)]);
+            if path == "/rooms" {
+                request = request.header("cookie", &guest_cookie);
+            }
+            let rows: Vec<Value> = request
+                .send()
+                .await
+                .unwrap()
+                .error_for_status()
+                .unwrap()
+                .json()
+                .await
+                .unwrap();
+            assert_eq!(rows.len(), 3, "{path} {query}");
+            assert!(rows.iter().all(|row| row["id"] != "rust-secret"));
+        }
+        for (q, id) in [("%", "percent"), ("_", "underscore"), (r"\", "slash")] {
+            let mut request = client.get(format!("{}{path}", f.url)).query(&[("q", q)]);
+            if path == "/rooms" {
+                request = request.header("cookie", &guest_cookie);
+            }
+            let rows: Vec<Value> = request.send().await.unwrap().json().await.unwrap();
+            assert_eq!(rows.len(), 1);
+            assert_eq!(rows[0]["id"], id);
+        }
+    }
+    let own: Vec<Value> = client
+        .get(format!("{}/rooms", f.url))
+        .header("cookie", owner_cookie)
+        .query(&[("q", "Rust")])
+        .send()
+        .await
+        .unwrap()
+        .json()
+        .await
+        .unwrap();
+    assert_eq!(own.len(), 4); // invited/own private room still visible to the authorized user.
+    let injected: Vec<Value> = client
+        .get(format!("{}/public/rooms", f.url))
+        .query(&[("q", "' OR 1=1 --")])
+        .send()
+        .await
+        .unwrap()
+        .json()
+        .await
+        .unwrap();
+    assert!(injected.is_empty());
+    assert_eq!(
+        client
+            .get(format!("{}/public/rooms", f.url))
+            .query(&[("q", "x".repeat(201))])
+            .send()
+            .await
+            .unwrap()
+            .status(),
+        400
+    );
+}
