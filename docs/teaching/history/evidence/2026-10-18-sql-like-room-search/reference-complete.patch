@@ -0,0 +1,78 @@
+//! Opt-in native acceptance instrumentation. Runs only in a dedicated fixture
+//! process built with `acceptance-probe`; never touches user files or AI.
+use tauri::{Manager, PhysicalPosition};
+
+pub fn start(app: &tauri::AppHandle, enabled: bool) -> Result<(), String> {
+    let scenario = std::env::var("PET_ACCEPTANCE_SCENARIO").map_err(|e| e.to_string())?;
+    if !matches!(
+        scenario.as_str(),
+        "enabled" | "disabled" | "boundary" | "close"
+    ) {
+        return Err("unknown acceptance scenario".into());
+    }
+    if enabled != (scenario != "disabled") {
+        return Err("scenario and PET_ENABLE_ROAM disagree".into());
+    }
+    let main = app.get_webview_window("main").ok_or("missing main")?;
+    let pet = app.get_webview_window("pet").ok_or("missing pet")?;
+    let app = app.clone();
+    tauri::async_runtime::spawn(async move {
+        let result = async {
+            // Window managers can apply initial placement after setup. Wait for
+            // mapped windows, then position fixtures before starting roaming.
+            tokio::time::sleep(std::time::Duration::from_millis(1500)).await;
+            let monitor = pet.current_monitor().map_err(|_| "monitor unavailable")?.ok_or("missing monitor")?;
+            let area = monitor.work_area().clone();
+            let size = pet.outer_size().map_err(|_| "mapped pet size unavailable")?;
+            let x = area.position.x + (area.size.width.saturating_sub(size.width)) as i32;
+            let y = area.position.y + (area.size.height.saturating_sub(size.height)) as i32;
+            let initial = if scenario == "boundary" { PhysicalPosition::new(x, y) } else { PhysicalPosition::new(300, 300) };
+            main.set_position(PhysicalPosition::new(100, 100)).map_err(|_| "cannot position main fixture")?;
+            pet.set_position(initial).map_err(|_| "cannot position pet fixture")?;
+            tokio::time::sleep(std::time::Duration::from_millis(500)).await;
+            let main = app.get_webview_window("main").ok_or("main disappeared")?;
+            let pet = app.get_webview_window("pet").ok_or("pet disappeared")?;
+            let main_start = main.outer_position().map_err(|_| "main position unavailable")?;
+            let pet_start = pet.outer_position().map_err(|_| "pet position unavailable")?;
+            if pet_start != initial { return Err("window manager did not accept requested fixture position"); }
+            if enabled {
+                let handle = app.clone();
+                tauri::async_runtime::spawn(async move { crate::roam::roam_desktop(handle).await; });
+            }
+            println!("NATIVE_FIXTURE {}", serde_json::json!({"scenario":scenario,"pet_start":[pet_start.x,pet_start.y],"main_start":[main_start.x,main_start.y],"size":[size.width,size.height],"area":[area.position.x,area.position.y,area.size.width,area.size.height]}));
+            let mut moved = false;
+            let mut samples = Vec::new();
+            for _ in 0..16 {
+                tokio::time::sleep(std::time::Duration::from_millis(125)).await;
+                let m = main.outer_position().map_err(|_| "main position unavailable")?;
+                let p = pet.outer_position().map_err(|_| "pet position unavailable")?;
+                if m != main_start { return Err("main moved during automatic roaming"); }
+                moved |= p != pet_start;
+                if p.x < area.position.x || p.y < area.position.y || p.x > x || p.y > y {
+                    eprintln!("NATIVE_BOUNDARY_OBSERVED: x={} y={} expected x={}..{} y={}..{} current_size={:?} current_monitor={:?}", p.x, p.y, area.position.x, x, area.position.y, y, pet.outer_size(), pet.current_monitor());
+                    return Err("pet escaped monitor work area");
+                }
+                samples.push((p.x, p.y, m.x, m.y));
+            }
+            if moved != enabled { return Err("observed motion disagrees with enabled state"); }
+            if scenario == "close" {
+                pet.close().map_err(|_| "cannot close pet")?;
+                tokio::time::sleep(std::time::Duration::from_millis(800)).await;
+                if app.get_webview_window("pet").is_some() { return Err("pet did not close"); }
+                if main.outer_position().map_err(|_| "main unavailable")? != main_start {
+                    return Err("roaming fell back to main after pet closed");
+                }
+            }
+            println!("NATIVE_ACCEPTANCE {}", serde_json::json!({"scenario":scenario,"passed":true,"samples_pet_x_y_main_x_y":samples,"moved":moved,"work_area":[area.position.x,area.position.y,area.size.width as i32,area.size.height as i32]}));
+            Ok(())
+        }.await;
+        match result {
+            Ok(()) => app.exit(0),
+            Err(error) => {
+                eprintln!("NATIVE_ACCEPTANCE_FAILED: {error}");
+                app.exit(1);
+            }
+        }
+    });
+    Ok(())
+}
