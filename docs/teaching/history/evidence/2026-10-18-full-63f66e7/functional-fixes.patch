+                    chat: "fixture-chat".into(),
+                    pet: "fixture-pet".into(),
+                }),
+            },
+            config: None,
+            sessions: Arc::new(Mutex::new(HashMap::new())),
+            attempts: Arc::new(Mutex::new((Instant::now(), 0))),
+        };
+        let app = Router::new()
+            .route(
