+            tokio::time::timeout(Duration::from_secs(5), stream.read_to_end(&mut bytes))
+                .await
+                .unwrap()
+                .unwrap();
+            task.abort();
+            String::from_utf8(bytes).unwrap()
+        }
+
+        let state = Admin {
+            ingest: IngestState {
+                pool: sqlx::postgres::PgPoolOptions::new()
+                    .connect_lazy("postgres://fixture:fixture@127.0.0.1:1/fixture")
