{
  "sqlite_version": "3.46.1",
  "cases": [
    {
      "name": "owner explicit id",
      "sql": "insert into pet_owner(id,name) values('owner','fixture')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "pet explicit id and owner",
      "sql": "insert into pet_profile(id,name,species,owner_id) values('pet','fixture','cat','owner')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "AI explicit id",
      "sql": "insert into ai_person(id,name) values('ai','fixture')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "pet requires owner",
      "sql": "insert into pet_profile(id,name,species) values('missing-owner','fixture','cat')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "NOT NULL constraint failed: pet_profile.owner_id"
    },
    {
      "name": "pet_extra valid references",
      "sql": "insert into pet_extra(id,pet_id,owner_id) values('valid','pet','owner')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "pet_extra requires pet",
      "sql": "insert into pet_extra(id,owner_id) values('null-pet','owner')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "NOT NULL constraint failed: pet_extra.pet_id"
    },
    {
      "name": "pet_extra requires owner",
      "sql": "insert into pet_extra(id,pet_id) values('null-owner','pet')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "NOT NULL constraint failed: pet_extra.owner_id"
    },
    {
      "name": "pet_extra rejects missing pet",
      "sql": "insert into pet_extra(id,pet_id,owner_id) values('bad-pet','missing','owner')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "FOREIGN KEY constraint failed"
    },
    {
      "name": "pet_activity valid references",
      "sql": "insert into pet_activity(id,pet_id,owner_id) values('valid','pet','owner')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "pet_activity requires pet",
      "sql": "insert into pet_activity(id,owner_id) values('null-pet','owner')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "NOT NULL constraint failed: pet_activity.pet_id"
    },
    {
      "name": "pet_activity requires owner",
      "sql": "insert into pet_activity(id,pet_id) values('null-owner','pet')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "NOT NULL constraint failed: pet_activity.owner_id"
    },
    {
      "name": "pet_activity rejects missing pet",
      "sql": "insert into pet_activity(id,pet_id,owner_id) values('bad-pet','missing','owner')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "FOREIGN KEY constraint failed"
    },
    {
      "name": "pet_study valid references",
      "sql": "insert into pet_study(id,pet_id,owner_id) values('valid','pet','owner')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "pet_study requires pet",
      "sql": "insert into pet_study(id,owner_id) values('null-pet','owner')",
      "expected": "rejected",
      "actual": "rejected",
      "error": "NOT NULL constraint failed: pet_study.pet_id"
    },
    {
