      "error": "NOT NULL constraint failed: ai_person_life_log.room_id"
    },
    {
      "name": "AI log valid required fields",
      "sql": "insert into ai_person_life_log(id,ai_person_id,room_id) values('valid','ai',1)",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "owner PK still nullable",
      "sql": "insert into pet_owner(name) values('missing id')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "pet PK still nullable",
      "sql": "insert into pet_profile(name,species,owner_id) values('missing id','cat','owner')",
      "expected": "accepted",
      "actual": "accepted"
    },
    {
      "name": "AI PK still nullable",
      "sql": "insert into ai_person(name) values('missing id')",
      "expected": "accepted",
      "actual": "accepted"
    }
