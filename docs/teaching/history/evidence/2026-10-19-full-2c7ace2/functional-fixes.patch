+            .route_layer(axum::middleware::from_fn_with_state(
+                state.clone(),
+                refresh_session,
+            ))
+            .with_state(state.clone());
+        let raw = "b".repeat(64);
+        let key = hash(&raw);
+        let cookie = format!("analytics_session={raw}");
+        let old_deadline = Instant::now() + Duration::from_secs(2);
+        state.sessions.lock().unwrap().insert(
+            key.clone(),
+            Session {
+                expires: old_deadline,
+                csrf: "fixture".into(),
+            },
+        );
