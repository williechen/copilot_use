+        tokio::time::sleep(Duration::from_millis(60)).await;
+        let response = exchange(app.clone(), &cookie).await;
+        assert!(response.starts_with("HTTP/1.1 401"), "{response}");
+        assert!(!response.to_lowercase().contains("set-cookie:"));
+        assert!(!state.sessions.lock().unwrap().contains_key(&key));
+
+        for cookie in [
+            "analytics_session=bad".to_string(),
+            format!("analytics_session={}", "c".repeat(64)),
