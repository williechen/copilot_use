+            config: None,
+            sessions: Arc::new(Mutex::new(HashMap::new())),
+            attempts: Arc::new(Mutex::new((Instant::now(), 0))),
+        };
+        let app = Router::new()
+            .route(
+                "/probe",
+                get(
+                    |State(state): State<Admin>, headers: HeaderMap| async move {
+                        csrf_for(&state, &headers)
+                            .map(|_| StatusCode::OK)
+                            .unwrap_or(StatusCode::UNAUTHORIZED)
+                    },
+                ),
