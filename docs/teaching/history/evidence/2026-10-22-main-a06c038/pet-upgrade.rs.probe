use sqlx::migrate::Migrator;
#[tokio::test]
async fn observes_two_historical_databases_without_erasing_pet() {
    let base=std::env::var("VALIDATION_BASELINES").unwrap();
    for label in ["pre24", "day24"] {
        let db=sqlx::sqlite::SqlitePoolOptions::new().max_connections(1).connect("sqlite::memory:").await.unwrap();
        Migrator::new(std::path::Path::new(&format!("{base}/{label}/desktop_pet"))).await.unwrap().run(&db).await.unwrap();
        desktop_pet::pet_store::PetStore{pool:db.clone()}.create("保留資料").await.unwrap();
        let result=sqlx::migrate!("./migrations").run(&db).await;
        let count:i64=sqlx::query_scalar("SELECT count(*) FROM pet_profile").fetch_one(&db).await.unwrap();
        println!("UPGRADE {label}: {result:?}; pet_rows={count}");
        assert_eq!(count,1);
    }
}
