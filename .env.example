# Copy to .env and replace all values with independently generated random secrets.
# Never commit .env.
CHAT_BOOTSTRAP_PASSWORD=REPLACE_WITH_INDEPENDENT_BOOTSTRAP_SECRET
ANALYTICS_BOOTSTRAP_PASSWORD=REPLACE_WITH_OTHER_BOOTSTRAP_SECRET
CHAT_DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
ANALYTICS_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_DB_PASSWORD
CHAT_API_TOKEN=REPLACE_WITH_RANDOM_CHAT_API_TOKEN_AT_LEAST_16
ANALYTICS_API_TOKEN=REPLACE_WITH_RANDOM_ANALYTICS_API_TOKEN_AT_LEAST_16

ANALYTICS_CHAT_TOKEN=REPLACE_WITH_INDEPENDENT_CHAT_INGEST_TOKEN
ANALYTICS_PET_TOKEN=REPLACE_WITH_INDEPENDENT_PET_INGEST_TOKEN
# Optional OpenAI; unset disables AI API (503), never a mock answer.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna

ANALYTICS_ADMIN_TOKEN=REPLACE_WITH_INDEPENDENT_GOVERNANCE_TOKEN
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional local collector; numeric loopback URLs only, never remote metadata.
COPILOT_LOCAL_OTLP_ENDPOINT=
